# MonkeyType ApeKey (MonkeyType > Account settings > Ape keys)
MONKEYTYPE_APE_KEY=your-monkeytype-ape-key-here
# admin account, created automatically on first boot (password: min. 12 chars, upper, lower, digit and symbol)
MONKEYTYPE_STATS_ADMIN_EMAIL=admin@example.com
MONKEYTYPE_STATS_ADMIN_PASSWORD=choose-a-secure-admin-password
# password for the Postgres container
POSTGRES_PASSWORD=choose-a-secure-password
